# Kameleo Configuration
KAMELEO_BASE_URL=http://localhost:5050
KAMELEO_PORT=5050
DEFAULT_BROWSER_TYPE=chrome
DEFAULT_FINGERPRINT_PLATFORM=desktop

# SSL/TLS Configuration
# Set to 'true' to ignore HTTPS certificate errors (useful for development/testing)
# WARNING: Only enable this if you understand the security implications
IGNORE_HTTPS_ERRORS=true

# Automation Configuration
AUTOMATION_URL=https://www.adn.com
AUTOMATION_TIMEOUT=30000
AUTOMATION_RETRIES=3

# Logging
LOG_LEVEL=info
